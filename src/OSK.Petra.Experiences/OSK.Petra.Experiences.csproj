<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<Nullable>enable</Nullable>
		<LangVersion>14</LangVersion>

		<RepositoryUrl>https://github.com/OpenSourceKingdom/OSK.Petra.Experiences</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>CS1591</NoWarn>
		<Authors>BlankDev117</Authors>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<Description>A library that handles experiences for an application. e.g. Quests, Campaigns, Objectives, etc. A generic logic layer for handling most use cases for story narratives and related data tracking.</Description>
		<PackageTags>OpenSourceKingdom, OpenSource, Petra, Experience, Story, Quest, Objective, Mission, Narrative, Challenge </PackageTags>
		<Title>OSK.Petra.Experiences</Title>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0" />
		<PackageReference Include="OSK.Hexagonal.MetaData" Version="1.0.0" />
		<PackageReference Include="OSK.Messages.Abstractions" Version="0.5.1" />
		<PackageReference Include="PolySharp" Version="1.17.1">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

</Project>
